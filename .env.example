# GEMINI_API_KEY: Optional AI Studio runtime variable
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where this applet is hosted
APP_URL="https://localhost:3000"

# NODE_ENV: Set to "production" when deploying
NODE_ENV="development"

# PORT: HTTP server listening port (default 3000)
PORT="3000"

# CURRENT_APP_VERSION: Keys issued for older versions are automatically invalidated
CURRENT_APP_VERSION="1.0.0"

# APP_SECRET: Strong random 32+ byte hex/base64 secret for HMAC token & key encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="CHANGE_THIS_TO_A_STRONG_64_CHAR_HEX_SECRET_BEFORE_PRODUCTION"

# ADMIN_PASSWORD: Required separate admin password for Hidden Admin Console
# Set a strong password in production; never expose in frontend code.
ADMIN_PASSWORD=""

# SQLITE_DB_PATH: Path to persistent SQLite database file
SQLITE_DB_PATH="./data/sayan_mode.db"

# TELEGRAM_BOT_TOKEN & TELEGRAM_CHAT_ID: Optional Telegram Bot integration for user feedback
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
